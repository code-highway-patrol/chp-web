# Used by scripts/virustotal-scan.mjs to scan each statue's content. The
# scanner is a one-shot tool: results are committed to
# src/marketplace/virustotal-results.json and the runtime never reads this
# key. Add it locally to .env.local (gitignored). For CI re-scans, set the
# same name as a GitHub Actions / Vercel secret.
VIRUSTOTAL_API_KEY=
